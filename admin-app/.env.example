# 目标仓库：后台会把内容提交到这里，GitHub 收到 commit 后触发 EdgeOne 自动重建
VITE_GITHUB_OWNER=cModules
VITE_GITHUB_REPO=openrobot_website
VITE_GITHUB_BRANCH=main

# 内容文件在仓库中的路径
VITE_CONTENT_PATH=src/data/content.json

# 主站地址（资源库用）。资源接口跑在主站域名下，后台要跨站调用它。
# 本地开发填 http://localhost:5173，线上填主站域名，例如 https://xxx.edgeone.app
VITE_SITE_API_BASE=http://localhost:5173

# 后台登录口令。
# 注意：静态部署时这个口令会被打进 JS 产物，只能挡住随意浏览，
# 真正控制写入权限的是登录页填写的 GitHub Token（只存在浏览器里，不进仓库）。
# 本地调试可留空，上线务必设置。
VITE_ADMIN_PASSWORD=
